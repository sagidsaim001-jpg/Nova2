    <path
        android:pathData="M 32,54 A 22,12 -30 1,1 76,54 A 22,12 -30 1,1 32,54"
        android:strokeWidth="1.6"
        android:strokeColor="#50EC4899"
        android:fillColor="#00000000" />

    <!-- NOVA 4-Point Primary Star Core -->
    <path android:pathData="M54,26 C54,44 44,54 26,54 C44,54 54,64 54,82 C54,64 64,54 82,54 C64,54 54,44 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:color="#FF8B5CF6" android:offset="0.0" />
                <item android:color="#FFEC4899" android:offset="0.6" />
                <item android:color="#FFF59E0B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- NOVA Diagonal 4-Point Secondary Flare -->
    <path android:pathData="M54,38 C54,48 48,54 38,54 C48,54 54,60 54,70 C54,60 60,54 70,54 C60,54 54,48 54,38 Z">
