            <gradient
                android:startX="38"
                android:startY="38"
                android:endX="70"
                android:endY="70"
                android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FFE0E7FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central Radiant Spark -->
    <path
        android:pathData="M 54,51 A 3,3 0 1 1 53.9,51"
        android:fillColor="#FFFFFFFF" />

    <!-- Distant Cosmic Sparkles -->
    <path
        android:pathData="M 36,36 L 38,38 L 36,40 L 34,38 Z"
        android:fillColor="#FFC084FC" />
    <path
        android:pathData="M 72,70 L 73.5,71.5 L 72,73 L 70.5,71.5 Z"
